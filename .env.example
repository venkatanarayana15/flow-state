# ─────────────────────────────────────────────────────────────
#  PayFlow — environment template
#
#  Copy this file to `.env` and fill in your own keys:
#      Copy-Item .env.example .env        (PowerShell)
#      cp .env.example .env               (bash)
#
#  `.env` is gitignored. Never commit it. Never show it on camera.
# ─────────────────────────────────────────────────────────────

# ArmorIQ — platform.armoriq.ai → Settings → API Keys
# Must start with ak_live_ or ak_test_ or the SDK rejects it.
ARMORIQ_API_KEY=ak_your_key_here

# Which ArmorIQ backend that key belongs to. The PREFIX does not tell you:
# a staging key can also start with ak_live_. If bootstrap returns
# 401 "Invalid or expired API key", the key may be fine and pointed at the
# wrong backend — set this to staging and retry before generating a new key.
#   production (default) → api.armoriq.ai
#   staging              → staging-api.armoriq.ai  (keys from dev.armoriq.ai)
#   local                → 127.0.0.1               (self-hosted)
ARMORIQ_ENV=production

# Google AI Studio — aistudio.google.com/apikey (the free tier is enough)
# The variable name matters: GEMINI_API_KEY, not GOOGLE_API_KEY.
GEMINI_API_KEY=your_gemini_key_here

# The identity that owns the ArmorIQ session. ArmorIQ applies THIS person's
# policy, which is what makes the two-user beat possible.
ARMORIQ_USER_EMAIL=you@example.com

# The second identity in beat 4. Same goal, resolved against a different
# person, so the identical call can land differently.
#
# This address does NOT need its own ArmorIQ account: ArmorIQ resolves an
# unknown address as a non-member instead of rejecting it. What it must not be
# is the same address as ARMORIQ_USER_EMAIL above — both runs would resolve the
# same policy and the beat would print two identical verdicts.
ARMORIQ_USER_EMAIL_LOW=you+tier1@example.com

# Must match Console → Agents → Register Agent.
# A mismatch is silent: your policies simply never fire.
ARMORIQ_AGENT_NAME=payflow

# Must match Console → MCP Servers → Register MCP Server.
# A mismatch is silent too.
ARMORIQ_MCP_NAME=payflow

# How long a held call waits for a human before it is refused. Fails closed.
APPROVAL_WAIT_SECONDS=60

# Planner model. Verified working on this key:
#   gemini-3.5-flash-lite   (newest lite, but the tightest free-tier quota)
#   gemini-3.1-flash-lite   (also good; accepts thinkingConfig explicitly)
#   gemini-3.5-flash        (strongest of the above)
#   gemini-3.8-flash        (newest overall)
# gemini-2.5-flash still resolves but is superseded. gemini-2.0-flash 404s.
#
# Thinking controls differ per family: 2.5 and 3.1 accept
# `thinkingConfig: { thinkingBudget: 0 }`, while 3.5-flash-lite rejects the
# field outright. src/planner.js sends the strict config and drops it
# automatically on a 400, so any of these models works without editing code.
GEMINI_MODEL=gemini-3.1-flash-lite

# Web UI
PORT=3000

# Public demo protection. Per-IP runs allowed inside the window. In memory,
# so a restart only resets the count.
RATE_MAX_RUNS=40
RATE_WINDOW_MINUTES=10
